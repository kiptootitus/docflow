# ──────────────────────────────────────────────────────────────────────────
# DocFlow AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-this-strong-password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here          # Optional fallback

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_LIVE_MODE=False

# ── Email (SendGrid) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── AWS S3 (optional — uses local storage if not set) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=docflow-media
AWS_S3_REGION_NAME=us-east-1

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Celery Flower (monitoring UI) ─────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
